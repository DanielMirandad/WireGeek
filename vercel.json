{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/banner.js": {
      "maxDuration": 300
    },
    "api/banner-briefing.js": {
      "maxDuration": 300
    },
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/publicar.js": {
      "memory": 2048,
      "maxDuration": 300
    },
    "api/youtube.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/briefing-import.js": {
      "maxDuration": 300
    },
    "api/briefing-executor.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self'; media-src 'self' https: blob:; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
